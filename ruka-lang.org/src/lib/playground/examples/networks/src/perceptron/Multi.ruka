local Matrix = ruka.import("Matrix.ruka")

share t = record {
	layers: [Matrix.t]
	inputs: int
	hiddens: int
	outputs: int
	learning: float
}

share new = (inputs, hiddens, outputs, learning) do {
	layers = { Matrix.new() for 0..=hiddens }
	inputs
	hiddens
	outputs
	learning
}

share train (mut self) = (training, epochs) do
	for 0..epochs with (input, target) in training do
		self.backpropigate(input, target)
	end
end

share backpropigate (mut self) = (input, target) do

end

share predict (self) = (input) do

end

share feed_forward (self) = (input) do

end

local sigmoid = (z) do 1.0 / (1.0 + ruka.exp(-z))
